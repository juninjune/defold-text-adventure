-- Click-driven text adventure engine.
-- All nodes are created procedurally; story data comes from main/story.lua
-- (never edit that file from here).

local story = require("main.story")
local art = require("main.art")

------------------------------------------------------------
-- layout constants
------------------------------------------------------------

local SCREEN_W, SCREEN_H = 960, 720

-- illustration banner under the header; body text starts below it
local ART_W, ART_H, ART_TOP = 840, 168, 668
local TITLE_ART_H, TITLE_ART_TOP = 300, 700
local CLUE_ART_H = 240

local BODY_X, BODY_TOP, BODY_W = 60, 660, 840 -- screens without a banner
local BODY_TOP_ART = ART_TOP - ART_H - 22
local CHOICE_X, CHOICE_W = 60, 840
local CHOICE_COL_W, CHOICE_GAP = 412, 16
local BTN_H, BTN_PITCH, BLOCK_BOTTOM = 48, 56, 40

local HEADER_TITLE_X, HEADER_TITLE_Y = 60, 702
local HEADER_DIVIDER_Y = 680
local HEADER_RIGHT_X, HEADER_RIGHT_Y = 900, 698

local CIRCLED_DIGITS = { "①", "②", "③", "④", "⑤", "⑥" }

------------------------------------------------------------
-- color helpers
------------------------------------------------------------

-- convert 0xRRGGBB (+ optional alpha) into a gui color vector4
local function hex(rgb, a)
	local r = math.floor(rgb / 65536) % 256 / 255
	local g = math.floor(rgb / 256) % 256 / 255
	local b = rgb % 256 / 255
	return vmath.vector4(r, g, b, a or 1)
end

local BG_COLOR = hex(0x12141a)
local HEADER_TITLE_COLOR = hex(0x8e949c)
local DIVIDER_COLOR = hex(0x2a2f3a)
local BODY_TEXT_COLOR = hex(0xe6e0cf)
local PAGE_INDICATOR_COLOR = hex(0x5f6570)
local BTN_BORDER_COLOR = hex(0x343a4a)
local BTN_FILL_COLOR = hex(0x1c2029)
local BTN_LABEL_COLOR = hex(0xd8d2c2)
local BTN_HOVER_FILL_COLOR = hex(0x2b3245)
local BTN_HOVER_LABEL_COLOR = hex(0xffffff)
local BTN_DISABLED_LABEL_COLOR = hex(0x5a5f6a)
local TOAST_BG_COLOR = hex(0x2f3646)
local TOAST_TEXT_COLOR = hex(0xf0e8d0)
local TITLE_TITLE_COLOR = hex(0xf2ecd8)
local TITLE_SUB_COLOR = hex(0x9aa0a8)
local ENDING_TITLE_COLOR = hex(0xc9a961)

------------------------------------------------------------
-- small text/string utilities
------------------------------------------------------------

-- count UTF-8 codepoints (Korean chars are 3 bytes, not 1)
local function utf8_len(s)
	local n, i, len = 0, 1, #s
	while i <= len do
		local b = s:byte(i)
		if b < 0x80 then i = i + 1
		elseif b < 0xE0 then i = i + 2
		elseif b < 0xF0 then i = i + 3
		else i = i + 4 end
		n = n + 1
	end
	return n
end

-- split on blank-line paragraph breaks
local function split_paragraphs(text)
	local out = {}
	for para in (text .. "\n\n"):gmatch("(.-)\n\n") do
		table.insert(out, para)
	end
	if #out == 0 then table.insert(out, text) end
	return out
end

-- split into sentence-ish chunks at '.', '!', '?' or newline, keeping the
-- original spacing attached so concatenation reproduces the source text
local function split_sentences(text)
	local marked = text:gsub("([%.!?\n])", "%1\1")
	local out = {}
	for chunk in (marked .. "\1"):gmatch("(.-)\1") do
		if chunk ~= "" then table.insert(out, chunk) end
	end
	if #out == 0 then table.insert(out, text) end
	return out
end

------------------------------------------------------------
-- state object passed into story.lua callbacks
------------------------------------------------------------

local function new_state()
	local state = {}
	state.flags = {}
	state.clues = {}
	state.clue_order = {}
	state.visited = {}
	state.report = {}
	state.attempts = 0
	state._pending_toasts = {}

	function state:add_clue(id)
		if self.clues[id] then return false end
		self.clues[id] = true
		table.insert(self.clue_order, id)
		table.insert(self._pending_toasts, id)
		return true
	end

	function state:has(id) return self.clues[id] == true end
	function state:set(flag, v) self.flags[flag] = v end
	function state:get(flag) return self.flags[flag] end

	return state
end

------------------------------------------------------------
-- text measurement / pagination
------------------------------------------------------------

-- height (pre-scale) of text wrapped to `w` (pre-scale width)
local function measure_height(self, text, w, leading)
	local m = resource.get_text_metrics(self.font, text, { width = w, line_break = true, leading = leading or 1.0 })
	return m.height
end

-- split a long paragraph into chunks that each fit avail_h
local function paginate_single_paragraph(self, paragraph, avail_w, avail_h, scale, leading)
	local sentences = split_sentences(paragraph)
	local chunks = {}
	local current = {}
	for _, s in ipairs(sentences) do
		table.insert(current, s)
		local text = table.concat(current, "")
		local h = measure_height(self, text, avail_w, leading) * scale
		if h > avail_h then
			table.remove(current)
			if #current > 0 then
				table.insert(chunks, table.concat(current, ""))
				current = { s }
			else
				-- a single sentence alone overflows; accept it as its own page
				table.insert(current, s)
			end
		end
	end
	if #current > 0 then
		table.insert(chunks, table.concat(current, ""))
	end
	if #chunks == 0 then table.insert(chunks, paragraph) end
	return chunks
end

-- split body text (already split into paragraphs) into pages that each fit avail_h
local function paginate_paragraphs(self, paragraphs, avail_w, avail_h, scale, leading)
	local pages = {}
	local current = {}

	local function current_height()
		if #current == 0 then return 0 end
		return measure_height(self, table.concat(current, "\n\n"), avail_w, leading) * scale
	end

	local i = 1
	while i <= #paragraphs do
		local p = paragraphs[i]
		table.insert(current, p)
		if current_height() <= avail_h then
			i = i + 1
		else
			table.remove(current)
			if #current > 0 then
				table.insert(pages, table.concat(current, "\n\n"))
				current = {}
			else
				local chunks = paginate_single_paragraph(self, p, avail_w, avail_h, scale, leading)
				for _, c in ipairs(chunks) do table.insert(pages, c) end
				i = i + 1
			end
		end
	end
	if #current > 0 then
		table.insert(pages, table.concat(current, "\n\n"))
	end
	if #pages == 0 then table.insert(pages, "") end
	return pages
end

------------------------------------------------------------
-- choice layout
------------------------------------------------------------

-- decide 1-column vs 2-column layout and how tall the block is
local function compute_choice_layout(items)
	local n = #items
	local one_col = n <= 3
	if not one_col then
		for _, it in ipairs(items) do
			if utf8_len(it.label) > 16 then one_col = true break end
		end
	end
	local cols = one_col and 1 or 2
	local rows = one_col and n or math.ceil(n / 2)
	if rows < 1 then rows = 1 end
	return { cols = cols, rows = rows, block_top = BLOCK_BOTTOM + rows * BTN_PITCH }
end

------------------------------------------------------------
-- node builders
------------------------------------------------------------

-- wrapped text node; w/h are the FINAL visual size, scale divides it back
-- into node-local units the way gui.set_scale expects
local function create_text(self, text, x, y, w, scale, color, pivot, leading)
	local node = gui.new_text_node(vmath.vector3(x, y, 0), text)
	gui.set_font(node, "korean")
	gui.set_pivot(node, pivot)
	gui.set_scale(node, vmath.vector3(scale, scale, 1))
	gui.set_size(node, vmath.vector3(w / scale, 2000, 0))
	gui.set_line_break(node, true)
	gui.set_leading(node, leading or 1.0)
	gui.set_color(node, color)
	table.insert(self.nodes, node)
	return node
end

-- a bordered box button with a centered label; registers itself for
-- hover/click handling unless disabled
local function create_button(self, cx, cy, w, h, label, on_click, disabled)
	local pos = vmath.vector3(cx, cy, 0)
	local back = gui.new_box_node(pos, vmath.vector3(w, h, 0))
	gui.set_color(back, BTN_BORDER_COLOR)

	local front = gui.new_box_node(pos, vmath.vector3(w - 8, h - 8, 0))
	gui.set_color(front, BTN_FILL_COLOR)

	local lbl = gui.new_text_node(pos, label)
	gui.set_font(lbl, "korean")
	gui.set_pivot(lbl, gui.PIVOT_CENTER)
	gui.set_scale(lbl, vmath.vector3(0.8, 0.8, 1))
	gui.set_color(lbl, disabled and BTN_DISABLED_LABEL_COLOR or BTN_LABEL_COLOR)

	table.insert(self.nodes, back)
	table.insert(self.nodes, front)
	table.insert(self.nodes, lbl)

	if not disabled and on_click then
		table.insert(self.buttons, {
			hit = front,
			front = front,
			label = lbl,
			base_front = BTN_FILL_COLOR,
			base_label = BTN_LABEL_COLOR,
			hover_front = BTN_HOVER_FILL_COLOR,
			hover_label = BTN_HOVER_LABEL_COLOR,
			on_click = on_click,
		})
	end

	return { back, front, lbl }
end

-- lay out a list of {label, on_click, disabled} items into buttons
local function build_choices(self, items, layout, btn_h, pitch)
	btn_h = btn_h or BTN_H
	pitch = pitch or BTN_PITCH
	local nodes = {}
	for i, it in ipairs(items) do
		local row, col
		if layout.cols == 1 then
			row, col = i - 1, 0
		else
			row, col = math.floor((i - 1) / 2), (i - 1) % 2
		end
		local top = layout.block_top - row * pitch
		local cy = top - btn_h / 2
		local w, cx
		if layout.cols == 1 then
			w, cx = CHOICE_W, CHOICE_X + CHOICE_W / 2
		else
			w = CHOICE_COL_W
			cx = CHOICE_X + col * (CHOICE_COL_W + CHOICE_GAP) + CHOICE_COL_W / 2
		end
		local created = create_button(self, cx, cy, w, btn_h, it.label, it.on_click, it.disabled)
		for _, n in ipairs(created) do table.insert(nodes, n) end
		if not it.disabled and it.on_click then
			local b = self.buttons[#self.buttons]
			b.is_choice = true
			if it.label == "계속 ▶" or it.label == "다음 ▶" then self.advance_btn = b end
		end
	end
	return nodes
end

-- small pill button anchored to its right edge, used in the header
local function create_header_button(self, right_x, cy, label, on_click)
	local w, h = 150, 34
	create_button(self, right_x - w / 2, cy, w, h, label, on_click, false)
	return w
end

------------------------------------------------------------
-- screen bookkeeping
------------------------------------------------------------

local function clear_screen(self)
	for _, n in ipairs(self.nodes) do
		gui.delete_node(n)
	end
	self.nodes = {}
	self.buttons = {}
	self.hovered = nil
	self.advance_btn = nil
end

-- dithered illustration banner: 1px frame + textured box, top edge at top_y
local function create_art(self, key, top_y, h)
	local data, tw, th = art.render(key, ART_W, h)
	local tex = "art:" .. key .. ":" .. tw .. "x" .. th
	if not self.textures[tex] then
		local ok, reason = gui.new_texture(tex, tw, th, "rgb", data)
		if ok or reason == gui.RESULT_TEXTURE_ALREADY_EXISTS then
			self.textures[tex] = true
		else
			print("ART_ERR", key, tostring(reason))
			return {}
		end
	end
	local cy = top_y - th / 2
	local frame = gui.new_box_node(vmath.vector3(480, cy, 0), vmath.vector3(tw + 2, th + 2, 0))
	gui.set_color(frame, DIVIDER_COLOR)
	local box = gui.new_box_node(vmath.vector3(480, cy, 0), vmath.vector3(tw, th, 0))
	gui.set_texture(box, tex)
	table.insert(self.nodes, frame)
	table.insert(self.nodes, box)
	return { frame, box }
end

local function fade_in(nodes)
	for _, n in ipairs(nodes) do
		gui.set_alpha(n, 0)
		gui.animate(n, "color.w", 1, gui.EASING_OUTQUAD, 0.25)
	end
end

------------------------------------------------------------
-- toast queue
------------------------------------------------------------

local function process_toast_queue(self)
	if self.toast_active then return end
	local cid = table.remove(self.toast_queue, 1)
	if not cid then return end
	self.toast_active = true

	local clue = self.story.clues[cid]
	local text = "수첩에 기록 — " .. clue.title
	-- header-row toast: never overlaps body text; shrink to 0.6 if it would be wider than 480px
	local scale = 0.7
	local w = math.max(220, utf8_len(text) * 16 + 48)
	if w > 480 then
		scale = 0.6
		w = math.min(480, math.max(220, utf8_len(text) * 16 * (0.6 / 0.7) + 48))
	end

	local box = gui.new_box_node(vmath.vector3(480, 700, 0), vmath.vector3(w, 44, 0))
	gui.set_color(box, TOAST_BG_COLOR)
	gui.set_alpha(box, 0)

	local lbl = gui.new_text_node(vmath.vector3(480, 700, 0), text)
	gui.set_font(lbl, "korean")
	gui.set_pivot(lbl, gui.PIVOT_CENTER)
	gui.set_scale(lbl, vmath.vector3(scale, scale, 1))
	gui.set_color(lbl, TOAST_TEXT_COLOR)
	gui.set_alpha(lbl, 0)

	gui.animate(box, "color.w", 1, gui.EASING_OUTQUAD, 0.2)
	gui.animate(lbl, "color.w", 1, gui.EASING_OUTQUAD, 0.2, 0, function()
		timer.delay(2.2, false, function()
			gui.animate(box, "color.w", 0, gui.EASING_OUTQUAD, 0.3)
			gui.animate(lbl, "color.w", 0, gui.EASING_OUTQUAD, 0.3, 0, function()
				gui.delete_node(box)
				gui.delete_node(lbl)
				self.toast_active = false
				process_toast_queue(self)
			end)
		end)
	end)
end

local function drain_toasts(self)
	local pending = self.state._pending_toasts
	if #pending == 0 then return end
	for _, cid in ipairs(pending) do table.insert(self.toast_queue, cid) end
	self.state._pending_toasts = {}
	process_toast_queue(self)
end

------------------------------------------------------------
-- scene / notebook / report rendering (mutually recursive)
------------------------------------------------------------

local goto_scene, enter_scene, render_scene, render_title_body, render_page, build_header
local render_report, render_report_result, open_option_select, submit_report, enter_notebook
local render_notebook_page, open_clue

-- header: title, divider, notebook button, page indicator
function build_header(self)
	local scr = self.screen
	if scr.hide_header then return end

	create_text(self, scr.title or "", HEADER_TITLE_X, HEADER_TITLE_Y, 700, 0.7,
		scr.header_color or HEADER_TITLE_COLOR, gui.PIVOT_NW, 1.0)

	local divider = gui.new_box_node(vmath.vector3(480, HEADER_DIVIDER_Y, 0), vmath.vector3(CHOICE_W, 1, 0))
	gui.set_color(divider, DIVIDER_COLOR)
	table.insert(self.nodes, divider)

	local right_x = HEADER_RIGHT_X
	local n_clues = #self.state.clue_order
	if scr.show_notebook and n_clues >= 1 then
		local label = string.format("수첩 (%d)", n_clues)
		local w = create_header_button(self, right_x, HEADER_RIGHT_Y, label, function()
			goto_scene(self, "@notebook")
		end)
		right_x = right_x - w - 16
	end

	if scr.pages and #scr.pages >= 2 then
		create_text(self, string.format("%d / %d", scr.page, #scr.pages), right_x, HEADER_TITLE_Y, 120, 0.6,
			PAGE_INDICATOR_COLOR, gui.PIVOT_NE, 1.0)
	end
end

-- render whichever page is currently active for a paginated screen
-- (used by both normal scenes and the notebook)
function render_page(self)
	clear_screen(self)
	local scr = self.screen
	local text = scr.pages[scr.page]
	local fade = {}
	if scr.art then
		for _, n in ipairs(create_art(self, scr.art, ART_TOP, ART_H)) do table.insert(fade, n) end
	end
	local body = create_text(self, text, BODY_X, scr.body_top or BODY_TOP, BODY_W, 1.0, BODY_TEXT_COLOR, gui.PIVOT_NW, 1.15)
	table.insert(fade, body)

	local is_last = scr.page >= #scr.pages
	local is_first = scr.page <= 1
	local function go(delta)
		return function()
			scr.page = scr.page + delta
			render_page(self)
		end
	end
	local cnodes

	if is_last then
		cnodes = build_choices(self, scr.final_items, scr.final_layout)
	elseif is_first then
		cnodes = build_choices(self, { { label = "계속 ▶", on_click = go(1) } },
			{ cols = 1, rows = 1, block_top = BLOCK_BOTTOM + BTN_PITCH })
	else
		cnodes = build_choices(self, {
			{ label = "◀ 이전", on_click = go(-1) },
			{ label = "계속 ▶", on_click = go(1) },
		}, { cols = 2, rows = 1, block_top = BLOCK_BOTTOM + BTN_PITCH })
	end

	for _, n in ipairs(cnodes) do table.insert(fade, n) end
	fade_in(fade)
	build_header(self)
	print("SCENE", scr.id, scr.page, #scr.pages)
end

-- choice defs (filtered by cond) -> button items wired to effect+goto_scene
local function build_choice_items(self, choices)
	local items = {}
	for _, c in ipairs(choices or {}) do
		if not c.cond or c.cond(self.state) then
			table.insert(items, { label = c.label, on_click = function()
				if c.effect then c.effect(self.state) end
				drain_toasts(self)
				goto_scene(self, c.next)
			end })
		end
	end
	return items
end

function render_title_body(self, text)
	local paragraphs = split_paragraphs(text)
	local nodes = {}
	table.insert(nodes, create_text(self, paragraphs[1] or "", 480, 340, 800, 1.8, TITLE_TITLE_COLOR, gui.PIVOT_CENTER, 1.15))
	if #paragraphs > 1 then
		local rest = {}
		for i = 2, #paragraphs do table.insert(rest, paragraphs[i]) end
		table.insert(nodes, create_text(self, table.concat(rest, "\n\n"), 480, 290, 800, 0.8, TITLE_SUB_COLOR, gui.PIVOT_N, 1.15))
	end
	return nodes
end

function render_scene(self, id, scene)
	local text = scene.text
	if type(text) == "function" then text = text(self.state) end
	local items = build_choice_items(self, scene.choices)

	if scene.style == "title" then
		clear_screen(self)
		self.screen = { kind = "scene", id = id, title = "", hide_header = true, show_notebook = false }
		local nodes = {}
		if scene.art and art.has(scene.art) then
			nodes = create_art(self, scene.art, TITLE_ART_TOP, TITLE_ART_H)
		end
		for _, n in ipairs(render_title_body(self, text)) do table.insert(nodes, n) end
		local layout = compute_choice_layout(items)
		local cnodes = build_choices(self, items, layout)
		for _, n in ipairs(cnodes) do table.insert(nodes, n) end
		fade_in(nodes)
		build_header(self)
		print("SCENE", id, 1, 1)
		return
	end

	local paragraphs = split_paragraphs(text)
	local final_layout = compute_choice_layout(items)
	local continue_layout = { cols = 1, rows = 1, block_top = BLOCK_BOTTOM + BTN_PITCH }
	local reserve_top = math.max(final_layout.block_top, continue_layout.block_top)
	local art_key = (scene.art and art.has(scene.art)) and scene.art or nil
	local body_top = art_key and BODY_TOP_ART or BODY_TOP
	local avail_h = body_top - (reserve_top + 24)
	local pages = paginate_paragraphs(self, paragraphs, BODY_W, avail_h, 1.0, 1.15)

	self.screen = {
		kind = "scene", id = id, pages = pages, page = 1,
		art = art_key, body_top = body_top,
		final_items = items, final_layout = final_layout,
		title = scene.title or "",
		header_color = (scene.style == "ending") and ENDING_TITLE_COLOR or nil,
		show_notebook = scene.style ~= "ending",
	}
	render_page(self)
end

-- notebook: a paged grid of clue titles; each opens a detail screen with its illustration
function enter_notebook(self, page)
	local order = self.state.clue_order
	local total = 0
	for _ in pairs(self.story.clues or {}) do total = total + 1 end

	local final_items = { { label = "돌아가기", on_click = function() goto_scene(self, "@back") end } }
	for _, c in ipairs(self.story.notebook_choices or {}) do
		if not c.cond or c.cond(self.state) then
			table.insert(final_items, { label = c.label, on_click = function()
				local nxt = c.next
				if type(nxt) == "function" then nxt = nxt(self.state) end
				goto_scene(self, nxt)
			end })
		end
	end
	local final_layout = compute_choice_layout(final_items)

	-- grid rows that fit between the body top and the nav row (nav row only when paged)
	local function rows_avail(with_nav)
		local top_of_block = final_layout.block_top + (with_nav and BTN_PITCH or 0)
		return math.floor((BODY_TOP - 8 - (top_of_block + 16)) / BTN_PITCH)
	end
	local page_size = rows_avail(false) * 2
	if #order > page_size then page_size = rows_avail(true) * 2 end
	page_size = math.max(2, page_size)
	self.notebook_page_size = page_size

	local pages = {}
	for i, cid in ipairs(order) do
		local pi = math.floor((i - 1) / page_size) + 1
		pages[pi] = pages[pi] or {}
		table.insert(pages[pi], { index = i, id = cid })
	end
	if #pages == 0 then pages[1] = {} end
	page = math.max(1, math.min(page or 1, #pages))

	self.screen = {
		kind = "notebook", id = "@notebook", pages = pages, page = page,
		final_items = final_items, final_layout = final_layout,
		title = string.format("수첩 · 단서 %d / %d", #order, total), show_notebook = false,
	}
	render_notebook_page(self)
end

function render_notebook_page(self)
	clear_screen(self)
	local scr = self.screen
	local entries = scr.pages[scr.page]
	local n_pages = #scr.pages
	local fade = {}

	if #entries == 0 then
		table.insert(fade, create_text(self, "아직 기록한 것이 없다.", BODY_X, BODY_TOP, BODY_W, 1.0, BODY_TEXT_COLOR, gui.PIVOT_NW, 1.15))
	else
		local items = {}
		for _, e in ipairs(entries) do
			local clue = self.story.clues[e.id]
			table.insert(items, { label = clue.title, on_click = function() open_clue(self, e.index) end })
		end
		local layout = { cols = 2, rows = math.ceil(#items / 2), block_top = BODY_TOP - 8 }
		for _, n in ipairs(build_choices(self, items, layout)) do table.insert(fade, n) end
	end

	if n_pages >= 2 then
		local nav = {
			{ label = "◀ 이전", disabled = scr.page <= 1, on_click = function() scr.page = scr.page - 1; render_notebook_page(self) end },
			{ label = "다음 ▶", disabled = scr.page >= n_pages, on_click = function() scr.page = scr.page + 1; render_notebook_page(self) end },
		}
		local nav_layout = { cols = 2, rows = 1, block_top = scr.final_layout.block_top + BTN_PITCH }
		for _, n in ipairs(build_choices(self, nav, nav_layout)) do table.insert(fade, n) end
	end
	for _, n in ipairs(build_choices(self, scr.final_items, scr.final_layout)) do table.insert(fade, n) end

	fade_in(fade)
	build_header(self)
	print("SCENE", scr.id, scr.page, n_pages)
end

-- one clue: illustration banner + description + prev/next
function open_clue(self, idx)
	clear_screen(self)
	local order = self.state.clue_order
	local cid = order[idx]
	local clue = self.story.clues[cid]
	local key = "clue:" .. cid

	-- pages/page drive the header's "i / n" indicator
	self.screen = {
		kind = "clue", id = key, title = "수첩 · " .. clue.title, show_notebook = false,
		pages = order, page = idx,
	}
	local fade = {}
	local body_top = BODY_TOP
	if art.has(key) then
		for _, n in ipairs(create_art(self, key, ART_TOP, CLUE_ART_H)) do table.insert(fade, n) end
		body_top = ART_TOP - CLUE_ART_H - 22
	end
	table.insert(fade, create_text(self, clue.text, BODY_X, body_top, BODY_W, 1.0, BODY_TEXT_COLOR, gui.PIVOT_NW, 1.15))

	local page_of = math.ceil(idx / (self.notebook_page_size or 1))
	local final_items = { { label = "수첩으로", on_click = function() enter_notebook(self, page_of) end } }
	local final_layout = compute_choice_layout(final_items)
	local nav = {
		{ label = "◀ 이전 단서", disabled = idx <= 1, on_click = function() open_clue(self, idx - 1) end },
		{ label = "다음 단서 ▶", disabled = idx >= #order, on_click = function() open_clue(self, idx + 1) end },
	}
	for _, n in ipairs(build_choices(self, nav, { cols = 2, rows = 1, block_top = final_layout.block_top + BTN_PITCH })) do table.insert(fade, n) end
	for _, n in ipairs(build_choices(self, final_items, final_layout)) do table.insert(fade, n) end

	fade_in(fade)
	build_header(self)
	print("SCENE", key, idx, #order)
end

function open_option_select(self, report_id, slot)
	clear_screen(self)
	local items = {}
	for i, opt in ipairs(slot.options) do
		table.insert(items, { label = opt, on_click = function()
			self.state.report[slot.id] = i
			render_report(self, report_id)
		end })
	end
	table.insert(items, { label = "취소", on_click = function() render_report(self, report_id) end })

	self.screen = { kind = "option_select", id = "option_select:" .. slot.id, title = slot.label, show_notebook = false }
	local body = create_text(self, "해당하는 것을 고르시오.", BODY_X, BODY_TOP, BODY_W, 1.0, BODY_TEXT_COLOR, gui.PIVOT_NW, 1.15)
	local layout = compute_choice_layout(items)
	local fade = { body }
	local cnodes = build_choices(self, items, layout)
	for _, n in ipairs(cnodes) do table.insert(fade, n) end
	fade_in(fade)
	build_header(self)
	print("SCENE", self.screen.id, 1, 1)
end

function render_report(self, id)
	clear_screen(self)
	local scene = self.story.scenes[id]
	local n_slots = #scene.slots
	local rows = n_slots + 2

	local btn_h, pitch, body_scale = BTN_H, BTN_PITCH, 1.0
	if rows > 6 then
		btn_h, pitch, body_scale = 44, 52, 0.85
	end
	local block_top = BLOCK_BOTTOM + rows * pitch

	local items = {}
	for i, slot in ipairs(scene.slots) do
		local sel = self.state.report[slot.id]
		local val = sel and slot.options[sel] or "______"
		local label = string.format("%s %s  :  %s", CIRCLED_DIGITS[i] or tostring(i), slot.label, val)
		table.insert(items, { label = label, on_click = function() open_option_select(self, id, slot) end })
	end

	local can_submit = true
	for _, slot in ipairs(scene.slots) do
		if self.state.report[slot.id] == nil then can_submit = false end
	end
	table.insert(items, { label = scene.submit_label or "제출", disabled = not can_submit, on_click = function()
		submit_report(self, id)
	end })
	table.insert(items, { label = "돌아가기", on_click = function() goto_scene(self, scene.back) end })

	self.screen = { kind = "report", id = id, title = scene.title, show_notebook = false }

	local text = scene.text
	if type(text) == "function" then text = text(self.state) end
	local body = create_text(self, text, BODY_X, BODY_TOP, BODY_W, body_scale, BODY_TEXT_COLOR, gui.PIVOT_NW, 1.15)
	local fade = { body }
	local layout = { cols = 1, rows = rows, block_top = block_top }
	local cnodes = build_choices(self, items, layout, btn_h, pitch)
	for _, n in ipairs(cnodes) do table.insert(fade, n) end
	fade_in(fade)
	build_header(self)
	print("SCENE", id, 1, 1)
end

function submit_report(self, id)
	local scene = self.story.scenes[id]
	self.state.attempts = self.state.attempts + 1
	local n_wrong = 0
	for _, slot in ipairs(scene.slots) do
		if self.state.report[slot.id] ~= slot.answer then n_wrong = n_wrong + 1 end
	end
	if n_wrong == 0 then
		goto_scene(self, scene.on_correct)
	else
		render_report_result(self, id, n_wrong)
	end
end

function render_report_result(self, id, n_wrong)
	clear_screen(self)
	local scene = self.story.scenes[id]
	local text = scene.wrong_text(n_wrong, self.state.attempts)

	self.screen = { kind = "report_result", id = "report_result:" .. id, title = scene.title, show_notebook = false }
	local body = create_text(self, text, BODY_X, BODY_TOP, BODY_W, 1.0, BODY_TEXT_COLOR, gui.PIVOT_NW, 1.15)
	local items = { { label = "다시 살펴본다", on_click = function() render_report(self, id) end } }
	local layout = compute_choice_layout(items)
	local fade = { body }
	local cnodes = build_choices(self, items, layout)
	for _, n in ipairs(cnodes) do table.insert(fade, n) end
	fade_in(fade)
	build_header(self)
	print("SCENE", self.screen.id, 1, 1)
end

function enter_scene(self, id)
	if self.scene_stack[#self.scene_stack] ~= id then
		table.insert(self.scene_stack, id)
	end
	self.state.visited[id] = (self.state.visited[id] or 0) + 1
	local scene = self.story.scenes[id]
	if scene.on_enter then scene.on_enter(self.state) end
	drain_toasts(self)
	if scene.type == "report" then
		render_report(self, id)
	else
		render_scene(self, id, scene)
	end
end

function goto_scene(self, raw_id)
	local id = raw_id
	if type(id) == "function" then id = id(self.state) end

	if id == "@restart" then
		self.state = new_state()
		self.scene_stack = {}
		enter_scene(self, self.story.start)
		return
	end

	if id == "@notebook" then
		enter_notebook(self)
		return
	end

	if id == "@back" then
		if self.screen and self.screen.kind == "scene" then
			table.remove(self.scene_stack)
		end
		local target = self.scene_stack[#self.scene_stack] or self.story.start
		enter_scene(self, target)
		return
	end

	enter_scene(self, id)
end

------------------------------------------------------------
-- debug story validation
------------------------------------------------------------

local function validate_story(story)
	local errors = {}
	local scene_count = 0

	local function check_next(nxt, where)
		if type(nxt) == "function" then return end
		if nxt == "@back" or nxt == "@notebook" or nxt == "@restart" then return end
		if not story.scenes[nxt] then
			table.insert(errors, string.format("%s: unknown next '%s'", where, tostring(nxt)))
		end
	end

	for id, scene in pairs(story.scenes) do
		scene_count = scene_count + 1
		if scene.choices then
			for i, c in ipairs(scene.choices) do
				check_next(c.next, string.format("scene '%s' choice %d", id, i))
			end
		end
		if scene.type == "report" then
			if not scene.on_correct or not story.scenes[scene.on_correct] then
				table.insert(errors, string.format("report '%s': missing/invalid on_correct", id))
			end
			if not scene.back or not story.scenes[scene.back] then
				table.insert(errors, string.format("report '%s': missing/invalid back", id))
			end
			for _, slot in ipairs(scene.slots or {}) do
				if not slot.options or not slot.answer or slot.answer < 1 or slot.answer > #slot.options then
					table.insert(errors, string.format("report '%s' slot '%s': bad answer index", id, tostring(slot.id)))
				end
			end
		end
	end

	if not story.start or not story.scenes[story.start] then
		table.insert(errors, "story.start missing or invalid")
	end

	for i, c in ipairs(story.notebook_choices or {}) do
		check_next(c.next, string.format("notebook_choices %d", i))
	end

	local clue_count = 0
	for _ in pairs(story.clues or {}) do clue_count = clue_count + 1 end

	if #errors == 0 then
		print("STORY_OK", scene_count, clue_count)
	else
		for _, e in ipairs(errors) do print("STORY_ERR", e) end
	end
end

------------------------------------------------------------
-- lifecycle
------------------------------------------------------------

function init(self)
	msg.post(".", "acquire_input_focus")

	self.story = story
	self.font = gui.get_font_resource("korean")
	self.nodes = {}
	self.buttons = {}
	self.hovered = nil
	self.toast_queue = {}
	self.toast_active = false
	self.pressed_seen = false
	self.textures = {}
	self.scene_stack = {}
	self.screen = nil

	self.debug = sys.get_engine_info().is_debug
	if self.debug then
		validate_story(self.story)
		for id, sc in pairs(self.story.scenes) do
			if sc.art and not art.has(sc.art) then print("STORY_ERR unknown art", id, sc.art) end
		end
		for cid in pairs(self.story.clues) do
			if not art.has("clue:" .. cid) then print("STORY_ERR clue without art", cid) end
		end
	end

	self.state = new_state()

	self.bg = gui.new_box_node(vmath.vector3(480, SCREEN_H / 2, 0), vmath.vector3(SCREEN_W, SCREEN_H, 0))
	gui.set_color(self.bg, BG_COLOR)

	-- debug builds may jump straight to a scene: game.project [adv] start = <scene id>
	local start = self.story.start
	if self.debug then
		local override = sys.get_config_string("adv.start", "")
		if override ~= "" and (self.story.scenes[override] or override == "@notebook") then start = override end
		-- [adv] all_clues = 1 fills the notebook with every clue (for checking clue screens)
		if sys.get_config_int("adv.all_clues", 0) == 1 then
			local ids = {}
			for cid in pairs(self.story.clues) do table.insert(ids, cid) end
			table.sort(ids)
			for _, cid in ipairs(ids) do self.state:add_clue(cid) end
			self.state._pending_toasts = {}
		end
	end
	goto_scene(self, start)

	if self.debug then
		_G.__adv = { state = self.state, goto_scene = function(id) goto_scene(self, id) end, story = self.story }
	end
end

function on_input(self, action_id, action)
	if action_id == nil then
		local hit = nil
		for _, b in ipairs(self.buttons) do
			if gui.pick_node(b.hit, action.x, action.y) then
				hit = b
				break
			end
		end
		if hit ~= self.hovered then
			if self.hovered then
				gui.set_color(self.hovered.front, self.hovered.base_front)
				gui.set_color(self.hovered.label, self.hovered.base_label)
			end
			if hit then
				gui.set_color(hit.front, hit.hover_front)
				gui.set_color(hit.label, hit.hover_label)
			end
			self.hovered = hit
		end
		return
	end

	if action_id == hash("touch") then
		-- normal path: fire on press. Fallback: a release with no press seen
		-- since the last render (press+release inside one frame) also counts.
		local fire = false
		if action.pressed then
			self.pressed_seen = true
			fire = true
		elseif action.released then
			fire = not self.pressed_seen
			self.pressed_seen = false
		end
		if fire then
			for _, b in ipairs(self.buttons) do
				if gui.pick_node(b.hit, action.x, action.y) then
					b.on_click()
					break
				end
			end
		end
		return
	end

	if action_id == hash("advance") and action.pressed then
		if self.advance_btn then
			self.advance_btn.on_click()
			return
		end
		local only = nil
		local n = 0
		for _, b in ipairs(self.buttons) do
			if b.is_choice then
				n = n + 1
				only = b
			end
		end
		if n == 1 then only.on_click() end
	end
end
